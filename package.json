{
  "name": "@local/memory-sprite-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Memory Sprite demo: plugin and environment memory for DSH",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinny86389/memory-sprite.git"
  },
  "homepage": "https://github.com/vinny86389/memory-sprite",
  "bugs": {
    "url": "https://github.com/vinny86389/memory-sprite/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
